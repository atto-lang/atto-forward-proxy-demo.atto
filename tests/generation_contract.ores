import module generation from "../src/generation";
pub routine main(): int {
  val String source = "version: ores.proxy/v1\nmode: forward\nlisten:\n  host: 127.0.0.1\n  port: 8080\nruntime:\n  carriers: 20\n  actors: 100\n  max_inflight: 1024\n" +
    "policy:\n  deny_private: true\n  allow_domains: example.test\n  connect_ports: 443\n";
  val admission = generation.open(source, "forward");
  if admission.is_err(); then stdio.println("FAIL open"); return 1; fi
  val control = admission.unwrap();
  val first = control.snapshot().unwrap();
  if control.publish(1).is_ok(); then stdio.println("FAIL publish without prepare"); return 1; fi
  if control.prepare(source.replace_literal("allow_domains: example.test", "allow_domains: new.example.test")).is_err(); then
    stdio.println("FAIL prepare"); return 1;
  fi
  if control.prepare(source).is_ok(); then stdio.println("FAIL double prepare"); return 1; fi
  if control.publish(0).is_ok(); then stdio.println("FAIL stale epoch"); return 1; fi
  val next = control.publish(1);
  if next.is_err(); then stdio.println("FAIL publish"); return 1; fi
  if first.epoch != 1 || next.unwrap().epoch != 2; then
    stdio.println("FAIL generation pin"); return 1;
  fi
  if first.configuration.allow_domains != "example.test"; then
    stdio.println("FAIL old snapshot mutated"); return 1;
  fi
  if control.prepare("mode: forward\n").is_ok(); then
    stdio.println("FAIL malformed reload"); return 1;
  fi
  if control.prepare(source).is_err() || control.abort().is_err(); then
    stdio.println("FAIL abort"); return 1;
  fi
  stdio.println("PASS pure generation prepare/publish/abort");
  return 0;
}
