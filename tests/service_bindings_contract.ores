import module proxy_yaml from "../src/proxy_yaml";
import module generation from "../src/generation";
import module service_bindings from "../src/service_bindings";

pub routine main(): int {
  val String source = "version: ores.proxy/v1\nmode: forward\nlisten:\n  host: 127.0.0.1\n  port: 8080\nruntime:\n  carriers: 20\n  actors: 100\n  max_inflight: 1024\n" +
    "services:\n  - name: egress-policy\n    kind: actor\n    target: egress-v1\n" +
    "policy:\n  deny_private: true\n  allow_domains: example.test\n  connect_ports: 443\n";
  val parsed = proxy_yaml.parse(source, "forward");
  if parsed.is_err(); then stdio.println("FAIL valid service YAML"); return 1; fi
  val opened = generation.open(source, "forward");
  if opened.is_err(); then stdio.println("FAIL open service generation"); return 1; fi
  val supervisor = opened.unwrap();
  val old = supervisor.snapshot().unwrap();
  val allowed = service_bindings.bind(rt borrow old, "egress-policy");
  if allowed.is_err(); then stdio.println("FAIL service bind"); return 1; fi
  val old_bind = allowed.unwrap();
  if old_bind.target != "egress-v1" || old_bind.epoch != 1 ||
    old_bind.kind != "actor" ||
    service_bindings.bind(rt borrow old, "ambient-fetch").is_ok() ||
    service_bindings.bind(rt borrow old, "../egress-policy").is_ok(); then
    stdio.println("FAIL service capability boundary"); return 1;
  fi
  if proxy_yaml.parse(source.replace_literal("target: egress-v1",
      "target: ../arbitrary-source"), "forward").is_ok() ||
    proxy_yaml.parse(source.replace_literal("kind: actor", "kind: origin"), "forward").is_ok() ||
    proxy_yaml.parse(source.replace_literal("services:",
      "services:\n  - name: egress-policy\n    kind: actor\n    target: egress-v0"), "forward").is_ok(); then
    stdio.println("FAIL invalid service declaration"); return 1;
  fi
  val String reverse_with_service = "version: ores.proxy/v1\nmode: reverse\nlisten:\n  host: 127.0.0.1\n  port: 8080\nruntime:\n  carriers: 20\n  actors: 100\n  max_inflight: 1024\nroutes:\n  - name: api\n    host: api.example.test\n    path_prefix: /\n    upstream: https://api.example.test:443\nservices:\n  - name: egress-policy\n    kind: actor\n    target: egress-v1\n";
  if proxy_yaml.parse(reverse_with_service, "reverse").is_ok(); then
    stdio.println("FAIL forward-only service schema admitted in reverse mode"); return 1;
  fi
  if supervisor.prepare(source.replace_literal("target: egress-v1",
      "target: egress-v2")).is_err(); then
    stdio.println("FAIL stage actor version"); return 1;
  fi
  val next = supervisor.publish(1);
  if next.is_err(); then stdio.println("FAIL publish actor service"); return 1; fi
  val updated = next.unwrap();
  val new_bind = service_bindings.bind(rt borrow updated, "egress-policy");
  if new_bind.is_err() || new_bind.unwrap().target != "egress-v2" ||
    new_bind.unwrap().epoch != 2 || old_bind.target != "egress-v1" ||
    old_bind.epoch != 1; then
    stdio.println("FAIL generation-local service isolation"); return 1;
  fi
  stdio.println("PASS forward symbolic service binding contract; no runtime authority");
  return 0;
}
