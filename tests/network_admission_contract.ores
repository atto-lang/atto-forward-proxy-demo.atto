import module proxy_yaml from "../src/proxy_yaml";
import module generation from "../src/generation";
import module slot_pool from "../src/slot_pool";
import module traffic_controls from "../src/traffic_controls";
import module network_admission from "../src/network_admission";

pub routine main(): int {
  val String source = "version: ores.proxy/v1\nmode: forward\nlisten:\n  host: 127.0.0.1\n  port: 8080\nruntime:\n  carriers: 20\n  actors: 100\n  max_inflight: 1024\n" +
    "policy:\n  deny_private: true\n  allow_domains: example.test\n  connect_ports: 443\n";
  val parsed = proxy_yaml.parse(source, "forward");
  if parsed.is_err(); then stdio.println("FAIL forward fixture"); return 1; fi
  val snapshot = new generation.Snapshot(7, parsed.unwrap());

  val created = slot_pool.create(1);
  if created.is_err(); then stdio.println("FAIL request pool"); return 1; fi
  val admitted = created.unwrap().admit(7);
  if admitted.is_err(); then stdio.println("FAIL request lease"); return 1; fi
  val live = admitted.unwrap().state;
  val request = admitted.unwrap().handle;

  val zero = new traffic_controls.Window(7, 1000, 0);
  val rate_result = traffic_controls.allow_window(rt borrow zero,
    7, 1000, 1000, 2);
  if rate_result.is_err(); then stdio.println("FAIL rate fixture"); return 1; fi
  val rate = rate_result.unwrap();
  val closed_breaker = new traffic_controls.Breaker(7, 0, 0);
  val endpoint = new network_admission.ResolvedEndpoint(
    "api.example.test", "93.184.216.34", "443", true, true);

  val granted = network_admission.authorize_connect(rt borrow snapshot,
    rt borrow live, rt borrow request, rt borrow rate,
    rt borrow closed_breaker, rt borrow endpoint, 1000);
  if granted.is_err(); then
    stdio.println("FAIL fully admitted CONNECT should produce descriptor");
    return 1;
  fi
  val permit = granted.unwrap();
  if permit.epoch != 7 || permit.slot != request.slot ||
    permit.nonce != request.nonce ||
    permit.hostname != "api.example.test" ||
    permit.resolved_ip != "93.184.216.34"; then
    stdio.println("FAIL permit identity/pinning"); return 1;
  fi

  val unpinned = new network_admission.ResolvedEndpoint(
    "api.example.test", "93.184.216.34", "443", false, true);
  val private_ip = new network_admission.ResolvedEndpoint(
    "api.example.test", "10.0.0.7", "443", true, false);
  val wrong_host = new network_admission.ResolvedEndpoint(
    "evil.test", "93.184.216.34", "443", true, true);
  val wrong_port = new network_admission.ResolvedEndpoint(
    "api.example.test", "93.184.216.34", "80", true, true);
  if network_admission.authorize_connect(rt borrow snapshot, rt borrow live,
      rt borrow request, rt borrow rate, rt borrow closed_breaker,
      rt borrow unpinned, 1001).is_ok() ||
    network_admission.authorize_connect(rt borrow snapshot, rt borrow live,
      rt borrow request, rt borrow rate, rt borrow closed_breaker,
      rt borrow private_ip, 1001).is_ok() ||
    network_admission.authorize_connect(rt borrow snapshot, rt borrow live,
      rt borrow request, rt borrow rate, rt borrow closed_breaker,
      rt borrow wrong_host, 1001).is_ok() ||
    network_admission.authorize_connect(rt borrow snapshot, rt borrow live,
      rt borrow request, rt borrow rate, rt borrow closed_breaker,
      rt borrow wrong_port, 1001).is_ok(); then
    stdio.println("FAIL resolver/policy boundary widened"); return 1;
  fi

  val exhausted = new traffic_controls.Window(7, 1000, 1);
  val denied_rate = traffic_controls.allow_window(rt borrow exhausted,
    7, 1001, 1000, 1).unwrap();
  val open_breaker = new traffic_controls.Breaker(7, 2, 2000);
  if network_admission.authorize_connect(rt borrow snapshot, rt borrow live,
      rt borrow request, rt borrow denied_rate, rt borrow closed_breaker,
      rt borrow endpoint, 1001).is_ok() ||
    network_admission.authorize_connect(rt borrow snapshot, rt borrow live,
      rt borrow request, rt borrow rate, rt borrow open_breaker,
      rt borrow endpoint, 1001).is_ok(); then
    stdio.println("FAIL traffic-control denial bypass"); return 1;
  fi

  val closed = live.close(rt borrow request).unwrap();
  val recycled = closed.admit(8).unwrap();
  if network_admission.authorize_connect(rt borrow snapshot,
      rt borrow recycled.state, rt borrow request, rt borrow rate,
      rt borrow closed_breaker, rt borrow endpoint, 1001).is_ok(); then
    stdio.println("FAIL stale/recycled request handle authorized egress");
    return 1;
  fi
  val next_snapshot = new generation.Snapshot(8, parsed.unwrap());
  if network_admission.authorize_connect(rt borrow next_snapshot, rt borrow live,
      rt borrow request, rt borrow rate, rt borrow closed_breaker,
      rt borrow endpoint, 1001).is_ok(); then
    stdio.println("FAIL cross-generation request authorized egress");
    return 1;
  fi

  stdio.println("PASS pre-dial authority boundary: lease+epoch+rate+breaker+DNS");
  return 0;
}
