// Pure routing decisions over a validated immutable configuration snapshot.
// URI normalization and Host admission MUST be completed by the transport.
import module proxy_yaml from "./proxy_yaml";
define module route_policy as
  pub fnc prefix_match(String configured, String path): bool {
    if !path.starts_with("/") || path.starts_with("//"); then return false; fi
    if configured == "/"; then return true; fi
    if path == configured; then return true; fi
    if configured.ends_with("/"); then return path.starts_with(configured); fi
    return path.starts_with(configured + "/");
  }

  // Prefer the most-specific boundary-safe prefix, regardless of YAML order.
  // Return a separate Route value rather than exposing a mutable config alias.
  // The future hot path should compile this table to SoA prefix indices.
  pub fnc select(borrow proxy_yaml.Config snapshot, String host, String path):
      Result<proxy_yaml.Route, String> {
    let String best_prefix = "";
    let String best_name = "";
    let String best_host = "";
    let String best_upstream = "";
    let String best_middleware = "";
    for (const route of snapshot.routes) {
      if route.host == host && prefix_match(route.path_prefix, path); then
        if best_prefix == "" || prefix_match(best_prefix, route.path_prefix); then
          best_prefix = route.path_prefix;
          best_name = route.name;
          best_host = route.host;
          best_upstream = route.upstream;
          best_middleware = route.middleware;
        fi
      fi
    }
    if best_prefix == ""; then return Err("no configured reverse route"); fi
    return Ok(new proxy_yaml.Route(best_name, best_host,
      best_prefix, best_upstream, best_middleware));
  }

  // Syntactic policy only. A Config is publicly constructible, so check the
  // safe configuration invariants here instead of trusting every caller to
  // have gone through proxy_yaml.parse. Never authorize a socket on this basis.
  // Network transport still must authenticate, resolve and pin every address.
  pub fnc configured_domain(borrow proxy_yaml.Config snapshot, String candidate): bool {
    if snapshot.mode != "forward" || snapshot.deny_private != "true" ||
      snapshot.connect_ports != "443" || !proxy_yaml.valid_domain(candidate); then
      return false;
    fi
    val domains = snapshot.allow_domains.split_literal(",");
    if domains.size == 0 || domains.size > 128; then return false; fi
    // Validate *every* allowlist entry before matching any candidate. A bad
    // trailing entry must not be ignored because an earlier entry matched.
    for (const item of domains) {
      if !proxy_yaml.valid_domain(item); then return false; fi
    }
    for (const item of domains) {
      if candidate == item || candidate.ends_with("." + item); then
        return true;
      fi
    }
    return false;
  }

  // Strict syntactic CONNECT admission, NOT outbound network authorization.
  // Reuse the domain policy so port/deny-private and allowlist checks cannot
  // diverge between direct and metadata-derived CONNECT callers.
  pub fnc configured_connect(borrow proxy_yaml.Config snapshot,
                             String method, String authority): bool {
    if method != "CONNECT" || authority.contains_literal("@") ||
      authority.contains_literal("/") || authority.contains_literal("%") ||
      authority.contains_literal("?") || authority.contains_literal("#") ||
      authority.contains_literal(" ") || authority.contains_literal("[") ||
      authority.contains_literal("]") || authority.contains_literal("\\") ||
      authority.contains_literal("\r") || authority.contains_literal("\n") ||
      authority.contains_literal("\t") || authority.contains_literal("\u0000"); then
      return false;
    fi
    val parts = authority.split_literal(":");
    if parts.size != 2 || parts.get(1) != "443"; then return false; fi
    return configured_domain(rt borrow snapshot, parts.get(0));
  }

end
